# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# graphify code-graph output (generated)
/graphify-out/

# blog thumbnail generator intermediates: full-size PNGs before the webp
# conversion, plus the throwaway headless Chrome profile. The finished cards in
# public/blog/ are the committed artefact, these are not.
/scripts/thumbs/out/
# Generated from cards.mjs + the cutout by `npm run thumbs:data`.
/scripts/thumbs/assets/inline-data.js
